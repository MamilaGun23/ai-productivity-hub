# Server-only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Production: 'vercel' uses the deployed ai-generation Vercel Firewall rule.
# Leave blank locally. Other production hosts can use the Redis adapter below.
RATE_LIMIT_PROVIDER=
# Required for production unless RATE_LIMIT_PROVIDER=vercel is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional, enables local integration testing of production rate limiting.
REQUIRE_RATE_LIMIT=false
