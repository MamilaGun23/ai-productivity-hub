{
  "name": "AI generation request limit",
  "description": "Managed SDK limit for all AI tools: 10 requests per 600 seconds per client IP per region.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "rate_limit_api_id", "op": "eq", "value": "ai-generation" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 600,
        "limit": 10,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
